BLOC PATTERN TO ALWAYS FOLLOW
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// States always have 4 variants:
// Initial, Loading, Success, Failure

// Example:
abstract class OrderState extends Equatable {}
class OrderInitial extends OrderState {}
class OrderLoading extends OrderState {}
class OrderSuccess extends OrderState { final Order order; }
class OrderFailure extends OrderState { final String message; }

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
WHAT NOT TO DO — NEVER
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
- Never call Supabase directly from a widget or BLoC
- Never skip error handling
- Never use var for class fields — always type explicitly
- Never put multiple features in one file
- Never use print() — use proper logging
- Never store sensitive data in SharedPreferences — use flutter_secure_storage
- Never skip RLS policies on any Supabase table
- Never hardcode Supabase URL or anon key in code — use .env
